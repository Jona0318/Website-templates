{"nodes": [{"id": "patterns_bouwblokken_bibliotheek", "label": "PATTERNS.md \u2014 bouwblokken-bibliotheek", "file_type": "document", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One place with reusable patterns so building a new template = choose + adapt instead of writing from scratch; lowers token cost (read PATTERNS.md + templates.json, copy from the named source template)."}, {"id": "patterns_gedeelde_shell", "label": "Gedeelde shell (skelet premium+ templates)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed body order (skip-link, scroll-progress, intro, header, menu-overlay, main, footer) and a :root token grid (colors, easing, fonts, sizes) so every template is themeable by swapping variables; best complete shells to copy are templates 23 (dark) and 24 (light)."}, {"id": "patterns_animatie_opt_in", "label": "Animatie opt-in (reduced-motion-veilig)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "html starts as class 'js no-anim'; inline head script removes no-anim only when the user does not prefer reduced motion. Without JS everything stays visible (end states kept), so animation is progressive enhancement."}, {"id": "patterns_reveal_systeem", "label": "Reveal-systeem ([data-rv] + IntersectionObserver)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "patterns_scroll_raf_loop", "label": "E\u00e9n scroll-rAF-loop (header/progress/effecten in \u00e9\u00e9n frame)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All scroll-driven work batched in a single requestAnimationFrame tick with passive listeners, for performance."}, {"id": "patterns_canvas_boilerplate", "label": "Canvas-patroon (dpr-scaling, lazy IO-init, tab-pauze, reduced-motion fallback)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signature-level canvas boilerplate: devicePixelRatio capped at 2, init only when in view, pause when tab hidden, static draw for reduced-motion; deterministic seeded rng so compositions are reproducible. Canvas stays untainted (pure-code placeholders) so toDataURL PNG export works."}, {"id": "patterns_toggle_component", "label": "Toggle-componenten (prijs/modus, setMode)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "patterns_faq_accordion", "label": "FAQ-accordion (single-open, grid-template-rows 0fr\u21921fr)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "patterns_formulier_validatie", "label": "Formulier-validatie (per veld, succes-overlay)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "patterns_stijlregels", "label": "Stijl- en schrijfregels (NL-teksten, a11y, performance, typografie)", "file_type": "rationale", "source_file": "PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistency = reusability: all UI text Dutch with plausible fictional NL brands; prefer pure CSS/canvas compositions over stock photos; accessibility (focus-visible, aria, skip-link, reduced-motion) and premium detail accents (grain overlay, dot-pulse, conic border, intro curtain) are mandatory house style."}], "edges": [{"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_gedeelde_shell", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_animatie_opt_in", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_reveal_systeem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_scroll_raf_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_canvas_boilerplate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_toggle_component", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_faq_accordion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "patterns_bouwblokken_bibliotheek", "target": "patterns_formulier_validatie", "relation": "conceptually_related_to", "confidence"