{"nodes": [{"id": "readme_bron_galerij", "label": "Bron \u2014 verzameling van 165 kant-en-klare website-templates", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure HTML/CSS/JS with no build tools or dependencies; the gallery is a reference library: a new site is built by copying the nearest template and adapting, not from scratch."}, {"id": "readme_templates_json_index", "label": "templates.json \u2014 doorzoekbare index / bron van waarheid", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read templates.json (sector, palette, fonts, mechanics, sections) to pick a template instead of opening every index.html \u2014 saves tokens; the gallery card data is generated from it so gallery and index never drift."}, {"id": "readme_kit_generator", "label": "_kit generator (core.css/core.js + sections.mjs + build.mjs)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard sector sites are ~70% boilerplate; the generator captures the shared shell once and expands a ~100-line recipe into a fully standalone index.html (core inlined, no runtime dependency). Signature showpieces stay hand-written."}, {"id": "readme_distributie_scripts", "label": "Distributie-scripts (_kit/gallery.mjs, pack.mjs, readmes.mjs, npm run dist)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gallery.mjs writes gallery data from templates.json inline into index.html (between @gallery:start/@gallery:end) so it works over file:// without fetch/CORS; pack.mjs builds dependency-free downloads/<slug>.zip via Node zlib; readmes.mjs generates per-template READMEs."}, {"id": "readme_tier_systeem", "label": "Tier-systeem (basis \u00b7 premium \u2605 \u00b7 flagship/signature \u2726 \u00b7 maatwerk \u270e \u00b7 grafisch \u25c6 \u00b7 editorieel \u00a7)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shopify_themas", "label": "Importeerbare Shopify-thema's (Online Store 2.0 / Liquid, upload-klare zips)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_bron_galerij", "target": "patterns_bouwblokken_bibliotheek", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_bron_galerij", "target": "readme_templates_json_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_bron_galerij", "target": "readme_kit_generator", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_bron_galerij", "target": "readme_distributie_scripts", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_bron_galerij", "target": "readme_tier_systeem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_bron_galerij", "target": "readme_shopify_themas", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md"