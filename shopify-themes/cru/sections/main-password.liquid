<section class="hero">
  <div class="hero__overlay"></div>
  <div class="page-width">
    <div class="hero__inner text-center" style="margin-inline:auto;">
      <div class="hero__rule" style="margin-inline:auto;"></div>
      <h1 class="hero__title">{{ shop.name }}</h1>
      <p class="hero__text" style="margin-inline:auto;">{{ shop.password_message | default: 'Opening soon. Something premium is on the way.' }}</p>
      {%- form 'storefront_password', class: 'newsletter__form', style: 'margin-inline:auto;' -%}
        <input type="password" name="password" placeholder="Enter password" required>
        <button type="submit" class="btn btn--primary">Enter</button>
      {%- endform -%}
      {%- if form.errors -%}
        <p style="color:#e07a7a;margin-top:1rem;">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
