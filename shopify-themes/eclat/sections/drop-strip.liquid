{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="drop" aria-label="{{ section.settings.heading | default: 'This week' | escape }}">
  <div class="page-width">
    <div class="drop__head">
      <h2>{{ section.settings.heading | default: 'This week' | escape }}</h2>
      {%- if section.settings.hint != blank -%}<span class="hint">{{ section.settings.hint | escape }}</span>{%- endif -%}
    </div>
    <div class="strip" tabindex="0" aria-label="{{ section.settings.heading | default: 'This week' | escape }} carousel">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <a href="{{ product.url }}" class="scard">
            <div class="scard__m">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '300px', widths: '300,450,700' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="scard__b"><b>{{ product.title }}</b><span>{% render 'price', price_target: product %}</span></div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo = 'Apex Runner,Halo Sunglasses,Field Tote,Mono Cap,Volt Bottle,Studio Tee' | split: ',' -%}
        {%- for name in demo -%}
          <a href="{{ routes.all_products_collection_url }}" class="scard">
            <div class="scard__m">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="scard__b"><b>{{ name }}</b><span>€ {{ forloop.index | times: 30 | plus: 30 }},00</span></div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Drop strip",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This week" },
    { "type": "text", "id": "hint", "label": "Scroll hint", "default": "Scroll →" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 }
  ],
  "presets": [{ "name": "Drop strip" }]
}
{% endschema %}
