<header class="site-header">
  <div class="page-width site-header__inner">
    <button class="nav-toggle" data-nav-toggle aria-label="{{ 'accessibility.menu' | t }}" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="17" x2="21" y2="17"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        <img src="{{ settings.logo | image_url: width: 480 }}" width="{{ settings.logo_width }}" height="{{ logo_height }}" alt="{{ shop.name | escape }}" style="width: {{ settings.logo_width }}px; height: auto;">
      {%- else -%}
        {{ shop.name | split: ' ' | first }}<span>.</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" data-site-nav>
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.root_url }}">Editorial</a>
        <a href="{{ routes.search_url }}">Archive</a>
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="header-icon" data-search-open aria-label="{{ 'accessibility.search' | t }}">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="header-icon" data-cart-open aria-label="{{ 'accessibility.cart' | t }}">
        <span>{{ 'cart.general.title' | t }}</span><span class="cart-count" data-cart-count>({{ cart.item_count }})</span>
      </a>
    </div>
  </div>
</header>

<div class="search-panel" data-search-panel hidden>
  <div class="search-panel__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
      <input type="search" name="q" data-search-input autocomplete="off" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <button type="button" class="search-panel__close" data-search-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
    </form>
    <div class="search-results" data-search-results aria-live="polite"></div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
