<section class="hero">
  <div class="page-width">
    <div class="hero__idx">
      <span>{{ section.settings.index | default: 'Drop 01' | escape }} — {{ section.settings.season | default: 'Now live' | escape }}</span>
      {%- if section.settings.volume != blank -%}<span>{{ section.settings.volume | escape }}</span>{%- endif -%}
    </div>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <div class="hero__row">
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="link-underline">{{ section.settings.button_label_2 | escape }} <span class="arrow">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "index", "label": "Drop label", "default": "Drop 01" },
    { "type": "text", "id": "season", "label": "Status label", "default": "Now live" },
    { "type": "text", "id": "volume", "label": "Top-right label", "default": "Vol. 01 / 2026" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Use <br> for the line break and <em> to colour a word.", "default": "Design,<br><em>dropped</em>." },
    { "type": "text", "id": "text", "label": "Subtext", "default": "A concept store for design objects and a modern wardrobe — footwear, eyewear and the everyday, released in small monthly drops." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary link label", "default": "Lookbook" },
    { "type": "url", "id": "button_link_2", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
