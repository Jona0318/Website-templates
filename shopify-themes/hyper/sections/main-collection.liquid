<div class="collection-hero">
  <div class="page-width">
    <span class="eyebrow">Collection</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte" style="max-width:620px;margin-inline:auto;color:var(--color-text-muted);">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<section class="section">
  <div class="page-width">
    <div class="collection-toolbar">
      <span>{{ 'products.facets.product_count' | t: count: collection.products_count }}</span>
      {%- if section.settings.show_sorting -%}
        <form method="get" id="sort-form">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <label for="SortBy" class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</label>
          <select name="sort_by" id="SortBy" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 16 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid" style="--grid-cols: {{ section.settings.columns }};">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <p>No products found in this collection yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost">Browse all products</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_sorting",
      "label": "Show sorting",
      "default": true
    }
  ]
}
{% endschema %}
