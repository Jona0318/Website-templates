<section class="section">
  <div class="page-width">
    <div class="section__intro">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="lookbook" style="--look-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="look-tile" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400,600,800,1000' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span class="look-tile__label">
            <h3>{{ block.settings.title | escape }}</h3>
            <span class="arrow">&rarr;</span>
          </span>
        </a>
      {%- else -%}
        {%- for i in (1..3) -%}
          <a href="{{ routes.all_products_collection_url }}" class="look-tile" data-reveal>
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            <span class="look-tile__label"><h3>Category {{ i }}</h3><span class="arrow">&rarr;</span></span>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Departments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Homeware" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "tile", "settings": { "title": "Homeware" } },
        { "type": "tile", "settings": { "title": "Apparel" } },
        { "type": "tile", "settings": { "title": "Objects" } }
      ]
    }
  ]
}
{% endschema %}
