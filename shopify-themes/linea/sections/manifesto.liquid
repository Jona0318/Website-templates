<section class="section section--tight" style="border-block: 1px solid var(--color-border);">
  <div class="page-width">
    <blockquote class="manifesto" data-reveal>
      <p class="manifesto__quote">{{ section.settings.quote | escape }}</p>
      {%- if section.settings.attribution != blank -%}
        <cite class="manifesto__by">{{ section.settings.attribution | escape }}</cite>
      {%- endif -%}
    </blockquote>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto quote",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Good design is as little design as possible — and as much patience as it takes." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— The Linea studio" }
  ],
  "presets": [{ "name": "Manifesto quote" }]
}
{% endschema %}
