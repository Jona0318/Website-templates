<div class="collection-hero">
  <div class="page-width">
    <span class="eyebrow">Journal</span>
    <h1>{{ blog.title }}</h1>
  </div>
</div>

<section class="section">
  <div class="page-width">
    {%- paginate blog.articles by 9 -%}
      <div class="product-grid" style="--grid-cols: 3;">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="product-card">
            <div class="product-card__media" style="aspect-ratio:4/3;">
              {%- if article.image -%}
                {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="product-card__body">
              <span class="product-card__vendor">{{ article.published_at | date: '%d %b %Y' }}</span>
              <span class="product-card__title">{{ article.title }}</span>
              <p style="color:var(--color-text-muted);font-size:0.9rem;">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": []
}
{% endschema %}
