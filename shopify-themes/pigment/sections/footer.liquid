<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <div class="site-footer__logo">
          {{ shop.name | split: ' ' | first }}<span>.</span>
        </div>
        <p>{{ section.settings.tagline | default: shop.description | escape }}</p>
        <div class="footer-social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 2c.3 2.3 1.7 4 4 4.2v3c-1.5 0-2.9-.5-4-1.3v6.6A6.5 6.5 0 1 1 9.5 8v3.1a3.4 3.4 0 1 0 3.5 3.4V2z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.col1_title | escape }}</h4>
        <ul>
          {%- for link in linklists[section.settings.col1_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.col2_title | escape }}</h4>
        <ul>
          {%- for link in linklists[section.settings.col2_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.search_url }}">Search</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.newsletter_title | escape }}</h4>
        <p style="color: var(--color-text-muted); font-size: 0.9rem;">{{ section.settings.newsletter_text | escape }}</p>
        {%- form 'customer', class: 'newsletter__form', style: 'max-width:none;margin-top:1rem' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
          <button type="submit" class="btn btn--primary">→</button>
        {%- endform -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.copyright' | t }}</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Premium goods, made to last."
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Title",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Title",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Join for early access and private offers."
    }
  ]
}
{% endschema %}
