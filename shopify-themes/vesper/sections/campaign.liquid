<section class="campaign">
  <div class="campaign__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1200,1600,2000,2400' }}
    {%- else -%}
      <span class="campaign__fill"></span>
    {%- endif -%}
  </div>
  <div class="campaign__overlay">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Campaign band",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Leave empty for the gilded gradient." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Campaign — Vol. I" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Midnight Edit" },
    { "type": "text", "id": "text", "label": "Text", "default": "Photographed by candlelight — a study of gold against the dark." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the film" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Campaign band" }]
}
{% endschema %}
