<div class="cart-drawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
  <div class="cart-drawer__contents" data-cart-contents>
    <span data-cart-count-source data-count="{{ cart.item_count }}" hidden></span>
    <div class="cart-drawer__head">
      <h2>{{ 'cart.general.title' | t }} <span class="cart-drawer__count">{{ cart.item_count }}</span></h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
    </div>

    {%- if cart.item_count > 0 -%}
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="64" height="80" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart-line__info">
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-line__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-line__price">{{ item.final_line_price | money }}</div>
              <div class="cart-line__controls">
                <div class="quantity-input" data-quantity>
                  <button type="button" data-qty-step="-1" aria-label="Decrease">&minus;</button>
                  <input type="number" data-cart-qty data-line="{{ forloop.index }}" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'cart.general.quantity' | t }}">
                  <button type="button" data-qty-step="1" aria-label="Increase">+</button>
                </div>
                <button type="button" class="cart-line__remove" data-cart-remove data-line="{{ forloop.index }}">{{ 'cart.general.remove' | t }}</button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-drawer__foot">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__note">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
        <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--block">{{ 'cart.general.title' | t }}</a>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--primary btn--block">{{ 'cart.general.checkout' | t }}</button>
        </form>
      </div>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-cart-close>{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>
<div class="cart-overlay" data-cart-overlay hidden></div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
