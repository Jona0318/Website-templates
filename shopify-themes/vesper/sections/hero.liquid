<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__bg" aria-hidden="true">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '800,1200,1600,2000,2400' }}
    </div>
  {%- endif -%}
  <span class="hero__grain" aria-hidden="true"></span>
  <div class="page-width hero__in">
    <p class="hero__index hero__idx">{{ section.settings.index | default: 'Vol. I' | escape }} — {{ section.settings.season | default: 'The Midnight Edit' | escape }}</p>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="link-underline">{{ section.settings.button_label_2 | escape }} <span class="arrow">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
  <div class="hero__feet">
    <span>{{ section.settings.left_label | default: 'Est. MMXXVI' | escape }}</span>
    {%- if section.settings.cat1 != blank or section.settings.cat2 != blank or section.settings.cat3 != blank -%}
      <span class="cats">
        {%- if section.settings.cat1 != blank %}<span>{{ section.settings.cat1 | escape }}</span>{% endif -%}
        {%- if section.settings.cat2 != blank %}<span>{{ section.settings.cat2 | escape }}</span>{% endif -%}
        {%- if section.settings.cat3 != blank %}<span>{{ section.settings.cat3 | escape }}</span>{% endif -%}
      </span>
    {%- endif -%}
    {%- if section.settings.caption != blank -%}<span>{{ section.settings.caption | escape }}</span>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "index", "label": "Volume label", "default": "Vol. I" },
    { "type": "text", "id": "season", "label": "Edit label", "default": "The Midnight Edit" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Worn after <em>dark</em>." },
    { "type": "text", "id": "text", "label": "Subtext", "default": "A small house of jewellery, leather and scent — cast by hand, finished in gold, made to be kept for a lifetime." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the maison" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary link label", "default": "The atelier" },
    { "type": "url", "id": "button_link_2", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Optional background image", "info": "Sits behind the gold glow with a dark overlay. Leave empty for the pure spotlight look." },
    { "type": "text", "id": "left_label", "label": "Footer left label", "default": "Est. MMXXVI" },
    { "type": "text", "id": "cat1", "label": "Category 1", "default": "Jewellery" },
    { "type": "text", "id": "cat2", "label": "Category 2", "default": "Leather" },
    { "type": "text", "id": "cat3", "label": "Category 3", "default": "Fragrance" },
    { "type": "text", "id": "caption", "label": "Footer right caption", "default": "Pl. I — Gilded still life" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
