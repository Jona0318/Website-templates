<section class="newsletter">
  <div class="page-width">
    <div class="newsletter__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p style="color: var(--color-text-muted); max-width: 46ch; margin-inline: auto;">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p style="margin:0;color:var(--color-accent);font-family:var(--font-mono);font-size:0.8rem;">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
          <button type="submit">{{ 'general.newsletter_form.submit' | t }} &rarr;</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Correspondence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the index" },
    { "type": "text", "id": "text", "label": "Text", "default": "Quiet notes on new releases and restocks. No noise — a few times a season." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
