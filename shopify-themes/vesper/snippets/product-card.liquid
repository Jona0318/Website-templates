{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign idx = index | default: 1
-%}
<a href="{{ product.url }}" class="product-card" data-reveal>
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '300,450,600,800' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
    {%- if on_sale -%}
      <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </div>
  <div class="product-card__body">
    <span class="product-card__index">{{ idx | prepend: '00' | slice: -3, 3 }}{% if product.vendor != blank %} · <span class="product-card__vendor" style="display:inline">{{ product.vendor }}</span>{% endif %}</span>
    <span class="product-card__title">{{ product.title }}</span>
    <span class="product-card__price">{% render 'price', price_target: product %}</span>
  </div>
</a>
